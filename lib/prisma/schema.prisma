generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  TODO
  PENDING
  DONE

  @@map("status")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  priority    Priority
  createdAt   DateTime @default(now())
  status      Status   @default(TODO)
}
